<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>入貨作業 - <%= user.name %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body class="dashboard-mode">

    <nav class="navbar">
        <div class="nav-left">
            <span class="app-title">📦 入貨系統</span>
        </div>
        <div class="nav-right">
            <span class="user-name">👷 <%= user.name %></span>
            <a href="/auth/logout" class="btn-logout" style="margin-left: 10px; color: white; text-decoration: none;">[登出]</a>
        </div>
        </div>
    </nav>

    <div class="main-content">

        <div class="info-card">
            <h3>🔐 裝置資訊</h3>
            <p><strong>員工姓名：</strong> <%= user.name %></p>
            <p><strong>裝置 UUID：</strong> <span id="uuid-display">讀取中...</span></p>
            <p><strong>作業系統：</strong> <span id="os-display">讀取中...</span></p>
            <p><strong>裝置型號：</strong> <span id="model-display">讀取中...</span></p>
            <p><strong>登入時間：</strong> <span id="login-time-display">等待同步...</span></p>
        </div>

       
    <script src="https://cdnjs.cloudflare.com/ajax/libs/UAParser.js/1.0.37/ua-parser.min.js"></script>
    <script src="/js/app.js"></script>

</body>
</html>